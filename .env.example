# AdaReach SMS API Credentials
ADAREARCH_USERNAME=your_username
ADAREARCH_PASSWORD=your_password
ADAREARCH_BASE_URL=https://api.mobireach.com.bd
ADAREARCH_DEFAULT_SENDER=YourSenderID

# Dashboard Configuration
ADAREARCH_DASHBOARD_ENABLED=true
ADAREARCH_DASHBOARD_PORT=8090
ADAREARCH_DASHBOARD_PATH=sms-dashboard

# Redis Configuration
ADAREARCH_REDIS_CONNECTION=default
ADAREARCH_REDIS_PREFIX=adarearch:
ADAREARCH_RETENTION_DAYS=30

# Logging
ADAREARCH_LOGGING_ENABLED=true

# Broadcasting (Socket.IO Server)
BROADCAST_DRIVER=redis
SOCKET_IO_SERVER_HOST=localhost
SOCKET_IO_SERVER_PORT=3000
